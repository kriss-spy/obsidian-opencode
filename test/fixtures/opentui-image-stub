#!/usr/bin/env node

const sixel = Buffer.from(
	"",
	"base64",
);

if (process.argv.includes("--help")) {
	process.stdout.write("start opencode tui\n");
	process.exit(0);
}

process.stdin.setRawMode?.(true);
process.stdin.resume();
let input = "";
let rendered = false;

process.stdin.on("data", (chunk) => {
	input += chunk.toString("latin1");
	if (rendered || !input.includes("\x1b[?62;4;9;22c")) return;
	rendered = true;
	process.stdout.write(sixel);
	process.stdout.write("\r\nSIXEL_READY\r\n");
});

process.stdout.write("\x1b[c");
