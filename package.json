{
  "name": "obsidian-opencode",
  "version": "2.2.0",
  "description": "OpenCode CLI wrapper for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest run",
    "test:obsidian": "npm run build && wdio run ./wdio.conf.mts",
    "test:obsidian:smoke": "npm run build && cross-env OBSIDIAN_TEST_GREP='\\[smoke\\]' wdio run ./wdio.conf.mts",
    "test:obsidian:macos-ime": "npm run build && cross-env OBSIDIAN_TEST_GREP='#26' wdio run ./wdio.conf.mts",
    "test:obsidian:windows-ui": "npm run build && cross-env OPENCODE_REAL_E2E=1 OBSIDIAN_TEST_GREP=\"real OpenCode\" wdio run ./wdio.conf.mts",
    "test:obsidian:wsl-x410": "npm run build && node scripts/run-wsl-x410-tests.mjs",
    "embed:windows-pty": "node embed-windows-pty-binary.mjs && node embed-windows-pty-binary.mjs node_modules/zigpty/prebuilds/zigpty.win32-arm64.node src/pty/windowsPtyNativeArm64.ts WINDOWS_PTY_NATIVE_ARM64_BASE64",
    "embed:windows-job-host": "node embed-windows-job-host-binary.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "opencode"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "@wdio/cli": "^9.31.7",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.1",
    "obsidian": "^1.13.1",
    "typescript": "4.7.4",
    "vitest": "^4.1.11",
    "wdio-obsidian-reporter": "^3.2.0",
    "wdio-obsidian-service": "^3.2.0",
    "zigpty": "^0.2.1"
  },
  "dependencies": {
    "@xterm/addon-canvas": "0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.2",
    "mocha@11.8.0": {
      "diff": "8.0.4",
      "serialize-javascript": "7.1.1"
    }
  }
}
